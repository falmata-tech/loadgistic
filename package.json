{
  "name": "loadgistic-nextjs-mvp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-dev} next dev --turbopack --hostname 127.0.0.1 --port ${PORT:-3100}",
    "build": "node scripts/run-next-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "db:supabase:fixtures": "node scripts/import-supabase-fixtures.mjs --reset-local",
    "db:supabase:verify": "node scripts/verify-supabase-fixtures.mjs",
    "db:supabase:verify:shared": "node scripts/verify-supabase-shared-capacity.mjs",
    "db:supabase:verify:capacity": "node scripts/verify-supabase-provider-capacity.mjs",
    "db:supabase:verify:tracking": "node scripts/verify-supabase-provider-tracking.mjs",
    "db:supabase:verify:signup": "node scripts/verify-supabase-provider-signup.mjs",
    "db:supabase:verify:rate-limit": "node scripts/verify-supabase-rate-limit.mjs",
    "db:supabase:verify:uploads": "node scripts/verify-supabase-upload-scanning.mjs",
    "db:supabase:verify:profile": "node scripts/verify-supabase-provider-profile.mjs",
    "db:supabase:verify:fleet": "node scripts/verify-supabase-workspace-fleet.mjs",
    "db:supabase:verify:trust-billing": "node scripts/verify-supabase-verification-billing.mjs",
    "supabase:local:configure": "node scripts/configure-local-supabase.mjs --write-env --fixtures --verify",
    "db:stress": "node scripts/seed-market-scale-db.mjs",
    "test:scale": "node scripts/market-scale-audit.mjs",
    "db:fixtures:tracking": "node scripts/add-tracking-fixtures.mjs",
    "places:download": "node scripts/download-ethiopia-places.mjs",
    "places:import": "node scripts/import-ethiopia-places.mjs",
    "places:import:supabase": "node scripts/import-ethiopia-places-supabase.mjs",
    "places:setup": "npm run places:download && npm run places:import",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:critical": "node scripts/run-e2e.mjs --grep \"public entry|map clusters|visitor location|capacity summary|provider starts Tracking|provider edits business facts\"",
    "test:a11y": "node scripts/run-e2e.mjs tests/e2e/accessibility.spec.ts",
    "test:ui-audit": "node scripts/ui-audit.mjs",
    "test:ui-stress": "node scripts/stress-ui-audit.mjs",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:e2e:browserbase": "node scripts/browserbase-smoke.mjs",
    "marketing:videos": "node scripts/capture-marketing-videos.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check": "npm run check:specs && npm run check:source",
    "launch:check": "NODE_ENV=production node scripts/launch-check.mjs",
    "quality": "npm run check && npm test && npm run typecheck",
    "typecheck:offline": "tsc -p tsconfig.offline.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.22",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  },
  "type": "module"
}
