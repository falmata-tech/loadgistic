{
  "name": "loadgistic-nextjs-mvp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ui-audit": "node scripts/ui-audit.mjs",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:e2e:browserbase": "node scripts/browserbase-smoke.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check": "npm run check:specs && npm run check:source",
    "quality": "npm run check && npm test && npm run typecheck",
    "typecheck:offline": "tsc -p tsconfig.offline.json"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "@supabase/supabase-js": "2.111.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "22.13.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.22.0",
    "eslint-config-next": "15.2.4",
    "typescript": "5.8.2"
  },
  "type": "module"
}
