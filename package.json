{
  "name": "loadgistic-nextjs-mvp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=${NEXT_DIST_DIR:-.next-dev} next dev --turbopack",
    "build": "node scripts/run-next-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:reset": "node scripts/reset-db.mjs",
    "db:stress": "node scripts/seed-stress-db.mjs",
    "db:fixtures:tracking": "node scripts/add-tracking-fixtures.mjs",
    "places:download": "node scripts/download-ethiopia-places.mjs",
    "places:import": "node scripts/import-ethiopia-places.mjs",
    "places:import:supabase": "node scripts/import-ethiopia-places-supabase.mjs",
    "places:setup": "npm run places:download && npm run places:import",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:ui-audit": "node scripts/ui-audit.mjs",
    "test:ui-stress": "node scripts/stress-ui-audit.mjs",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:e2e:browserbase": "node scripts/browserbase-smoke.mjs",
    "marketing:videos": "node scripts/capture-marketing-videos.mjs",
    "brand:icons": "node scripts/generate-brand-icons.mjs",
    "check:source": "node scripts/check-source.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check": "npm run check:specs && npm run check:source",
    "launch:check": "NODE_ENV=production node scripts/launch-check.mjs",
    "quality": "npm run check && npm test && npm run typecheck",
    "typecheck:offline": "tsc -p tsconfig.offline.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.13.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.8.2"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
