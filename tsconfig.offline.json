{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["types/offline-shims.d.ts", "src/**/*.ts", "src/**/*.tsx", "playwright.config.ts", "tests/e2e/**/*.ts"],
  "exclude": ["node_modules"]
}
