{
  "expo": {
    "name": "Loadgistic",
    "slug": "loadgistic",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/loadgistic-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loadgistic.app"
    },
    "android": {
      "package": "com.loadgistic.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/loadgistic-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Loadgistic to use your location when you choose to update your truck location or find nearby trucks.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Allow Loadgistic to share an approximate shipment location until unloading is approved, including while the app is in the background.",
          "androidForegroundServiceIcon": "./assets/tracking-notification.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a truck, profile or document image to upload.",
          "cameraPermission": "Take a truck, profile or document photo.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/push-notification.png",
          "color": "#0c7275",
          "defaultChannel": "loadgistic-updates"
        }
      ]
    ],
    "owner": "falmatad",
    "scheme": "loadgistic",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2d7e0a9-2fe4-4188-804e-40d8c3486ac7"
      }
    }
  }
}
