{
  "name": "Loadgistic",
  "short_name": "Loadgistic",
  "description": "Road freight shipment and truck matching for Ethiopian businesses and transporters.",
  "id": "/app/home",
  "start_url": "/app/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f6f8fb",
  "theme_color": "#0c2a43",
  "categories": ["business", "productivity", "navigation"],
  "shortcuts": [
    { "name": "Update capacity", "short_name": "Capacity", "url": "/app/home", "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Shipment Board", "short_name": "Shipments", "url": "/app/loads", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "/landing/product-capacity-board.png", "sizes": "1440x900", "type": "image/png", "form_factor": "wide", "label": "Loadgistic Truck Board" },
    { "src": "/landing/product-driver-home.png", "sizes": "390x844", "type": "image/png", "form_factor": "narrow", "label": "Driver capacity controls" }
  ]
}
