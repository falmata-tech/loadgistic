# EAS reads this at the Git root. Upload only the native app and its shared code.
/*
!/apps
!/src
!/package.json
!/package-lock.json
/apps/*
!/apps/mobile
/src/*
!/src/lib

# This file replaces nested .gitignore rules for EAS; repeat all sensitive and
# generated exclusions. Native projects are regenerated by Expo Prebuild.
**/node_modules/
**/.git/
**/.expo/
**/.local/
**/.claude/
**/.codex/
**/.agents/
**/.env
**/.env.*
**/credentials.json
**/*firebase-adminsdk*.json
**/*service-account*.json
**/*service_account*.json
**/*.jks
**/*.keystore
**/*.p8
**/*.p12
**/*.key
**/*.pem
**/*.mobileprovision
**/*.log
**/*.tsbuildinfo
**/.DS_Store
**/.metro-health-check*
/apps/mobile/android/
/apps/mobile/ios/
/apps/mobile/.kotlin/
/apps/mobile/dist/
/apps/mobile/web-build/
/apps/mobile/tests/
/apps/mobile/expo-env.d.ts
