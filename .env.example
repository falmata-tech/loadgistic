# Local SQLite adapter
DATABASE_PATH=./data/loadgistic.db

# Required in production. Replace this example with a long random secret.
SESSION_SECRET=local-development-secret-change-before-production-1234

# Optional Supabase target adapter configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATA_BACKEND=sqlite
PRIVATE_STORAGE_BACKEND=local
PRIVATE_UPLOAD_DIR=./data/uploads

# Optional hosted browser smoke tests
BROWSERBASE_ENABLED=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
