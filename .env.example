# Required in production. Replace this example with a long random secret.
SESSION_SECRET=local-development-secret-change-before-production-1234
# Optional local fixture audiences, comma-separated. Never configure demo audiences in production.
LOADGISTIC_DEMO_SHARED_EMAILS=
# Required and distinct from SESSION_SECRET in production. This keeps stable
# Tracking owner/review codes valid when the login-session secret rotates.
TRACKING_CODE_SECRET=

# Required Supabase runtime configuration. Local development uses the isolated
# Supabase CLI project; Preview and Production use the linked hosted project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Never enable this in Preview or Production. It exists for deterministic local
# automated browser fixtures only. Normal local testing uses email codes.
ENABLE_LOCAL_FIXTURE_PASSWORD_LOGIN=false
UPLOAD_SCANNER_BACKEND=local
# Explicit antivirus-optional pilot: use validation-only, never local, in Production.
# This retains file validation/private access but does NOT virus-scan uploads.
# See docs/UPLOAD_POLICY_2026-09-13.md. Keep cloudmersive for managed antivirus.
# Production pilot option. Keep server-only; never submit private documents to
# the free public VirusTotal service.
CLOUDMERSIVE_API_KEY=
UPLOAD_SCANNER_TIMEOUT_MS=8000

# Public URL. Keep service-role values server-only.
APP_URL=http://127.0.0.1:3100

# Optional fleet GPS adapter. Server-only JSON arrays; never use NEXT_PUBLIC or
# Expo public configuration for these secrets. Leave blank without a separately
# provisioned gateway. See infra/telematics/README.md for the exact contracts.
TELEMATICS_GATEWAYS_JSON=
TELEMATICS_DEFAULT_GATEWAY_ID=
# Server-only ID of the registered synthetic gateway. Required to show the
# admin Demo GPS option; SQL still verifies the gateway and fictional owner.
TELEMATICS_DEMO_GATEWAY_ID=
# Separate credential for exact account-closure/erasure jobs. The ordinary
# ingestion credential must not be reused for privacy cleanup.
TELEMATICS_PRIVACY_GATEWAYS_JSON=

# Preferred production application email. Supabase Auth email remains a
# separate dashboard-managed SMTP boundary even when both use one sender.
RESEND_API_KEY=
LOADGISTIC_EMAIL_FROM=
LOADGISTIC_EMAIL_REPLY_TO=

# Written automatically by the isolated local Supabase configurator. The
# application ignores this loopback-only Mailpit adapter in Production.
LOADGISTIC_LOCAL_MAILPIT_URL=

# Coordinated synthetic marketplace worker. Leave disabled until its exact
# database migration, fixture targets, backup/recovery and hosted rollout pass.
# Netlify Production Functions only; never expose the signing secret to clients.
LOADGISTIC_DEMO_WORLD_ENABLED=false
LOADGISTIC_DEMO_WORLD_KILL_SWITCH=true
LOADGISTIC_DEMO_WORLD_SITE_ORIGIN=
LOADGISTIC_DEMO_WORLD_SITE_ID=
DEMO_WORLD_WORKER_SECRET=

# Separate hosted demo GPS/phone authorization. Inert by default. Keep the
# local loopback-only demo credential separate; never copy it to production.
LOADGISTIC_HOSTED_MOTION_ENABLED=false
LOADGISTIC_HOSTED_MOTION_KILL_SWITCH=true
LOADGISTIC_HOSTED_MOTION_SITE_ORIGIN=
LOADGISTIC_HOSTED_MOTION_SITE_ID=
LOADGISTIC_HOSTED_MOTION_SUPABASE_URL=
HOSTED_DEMO_MOTION_SECRET=

# Bounded application-email SMTP pilot. Configure every value or leave every
# value blank. Port 465 uses implicit TLS; port 587 requires STARTTLS. This
# password is server-only and is separate from the SMTP secret saved in
# Supabase Auth.
LOADGISTIC_SMTP_HOST=
LOADGISTIC_SMTP_PORT=
LOADGISTIC_SMTP_USER=
LOADGISTIC_SMTP_PASSWORD=

# Optional alternative outbound adapter retained for private integrations.
LOADGISTIC_EMAIL_WEBHOOK_URL=
LOADGISTIC_EMAIL_WEBHOOK_TOKEN=

# Optional public HTTPS tile source. Blank values use the direct attributed
# OpenStreetMap community endpoint and produce a production launch warning.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Optional hosted browser smoke tests
BROWSERBASE_ENABLED=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Enable only after matched schema/app, FCM credentials and device acceptance.
LOADGISTIC_NATIVE_PUSH_ENABLED=false
# Optional: only if the owner separately enables Expo enhanced push security.
# LOADGISTIC_EXPO_PUSH_ACCESS_TOKEN=
